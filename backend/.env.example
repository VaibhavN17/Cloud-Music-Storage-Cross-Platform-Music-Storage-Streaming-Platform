# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=https://cloudtunemax.vercel.app

# Database (PostgreSQL)
DATABASE_URL=postgresql://cloudmusic:cloudmusic_secret@localhost:5432/cloudmusic_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_32bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_32bytes_min
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 / S3 Storage (Single bucket setup: 'cloudtune')
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_CDN_DOMAIN=https://cdn.cloudmusic.app
R2_BUCKET_NAME=cloudtune

# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
APPLE_CLIENT_ID=com.cloudmusic.app
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=./keys/apple_private_key.p8

# SMTP Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@cloudmusic.app

# Logging & Admin
LOG_LEVEL=debug
ADMIN_INITIAL_EMAIL=admin@cloudmusic.app
ADMIN_INITIAL_PASSWORD=AdminSecurePassword123!
